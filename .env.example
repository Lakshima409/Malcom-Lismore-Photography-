# Malcolm Lismore Photography - Environment variables
# Copy this file to .env and adjust values as needed.
# .env is gitignored and must never be committed.

# ---- Application environment --------------------------------------------
# Set APP_ENV=production on production servers to enable the fail-closed
# configuration safeguard in includes/db.php. Any other value (or unset)
# permits local XAMPP defaults.
APP_ENV=development

# ---- Database connection (matches XAMPP defaults for local development) ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=malcolm_lismore
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---- Production notes ---------------------------------------------------
# On production, set APP_ENV=production and provide all DB_* values.
# DB_PASS must be non-empty. The application will refuse to start if any
# required variable is missing when APP_ENV=production.